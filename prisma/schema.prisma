generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (PgBouncer) — runtime
  directUrl = env("DIRECT_URL") // direct — prisma migrate only
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(BUSINESS)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business  Business?
  favorites Favorite[]
  accounts  Account[]
  sessions  Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Business {
  id          String         @id @default(cuid())
  userId      String         @unique
  name        String?
  description String?
  categoryId  String?
  status      BusinessStatus @default(PENDING)

  logo       String?
  coverImage String?
  images     String[]
  services   Json?

  // ── Phase 1 · Step A1 — company information (all optional / safe defaults) ──
  companyStory       String?
  foundedYear        Int?
  companySize        CompanySize?
  employeeCount      Int?
  serviceModes       String[]     @default([])
  organizationNumber String?
  legalName          String?
  organizationType   String?
  highlightCodes     String[]     @default([])

  // ── Business identity summary — short factual statement shown in the hero ──
  // Localized (NO/EN), optional, backward-compatible. Not a slogan, marketing
  // copy, companyStory, or a category label.
  identitySummaryNo String?
  identitySummaryEn String?

  // ── Public by default, private by choice ────────────────────────────────
  // Names of the owner-hideable fields this business has chosen to keep off
  // the public profile. Empty — the default — means everything set is public,
  // so existing rows need no backfill and no field silently disappears.
  // Core identity (name, category) is deliberately not hideable.
  hiddenFields String[] @default([])

  // ── How the service is delivered, and where ─────────────────────────────
  // Replaces the older serviceModes list, which mixed delivery with reach.
  // serviceModes is kept as a column so this change stays reversible; it is
  // no longer written by the editor.
  deliveryMethods String[] @default([])
  serviceArea     String?

  // ── Owner-authored profile highlights, in display order ─────────────────
  // `[{ no, en }, …]` — business-authored public text, so each entry carries
  // both languages and either side may be null when the owner wrote only one.
  //
  // JSON rather than the paired-scalar shape used by identitySummaryNo/En,
  // because this is a *list*: two parallel String[] columns would let the
  // languages fall out of step the moment one array was written a different
  // length, and position is the only thing tying a highlight to its
  // translation. One JSON value keeps each pair atomic and order intrinsic.
  //
  // The fixed highlightCodes list this replaces is retained, so no existing
  // profile loses what it already shows.
  highlights Json?

  // ── Primary action ──────────────────────────────────────────────────────
  // bookingLink remains the URL — every stored booking link keeps working —
  // and these are only the owner's wording for it, per language. Scalar pairs
  // here rather than JSON, matching identitySummaryNo/En: it is a single
  // value, not a list, so there is no ordering to keep in step. Null falls
  // back to the existing localized default, so nothing has to be re-entered
  // and no missing translation is ever invented.
  primaryActionLabelNo String?
  primaryActionLabelEn String?

  // ── Exceptional opening hours — holidays and one-off dates ──────────────
  // A list of { date, mode, open?, close?, label?, holiday? }. Separate from
  // openingHours so the weekly schedule is never touched by a holiday edit.
  exceptionalHours Json?

  address    String?
  latitude   Float?
  longitude  Float?
  city       String?
  postalCode String?

  phone       String?
  email       String?
  website     String?
  bookingLink String?
  mapLink     String?

  openingHours Json?

  // ── Outreach demo profiles ──────────────────────────────────────────────
  // The authoritative flag for "this Business is a DinLinks example, not a real
  // company". Demos stay reachable at their own /business/<id> URL so they can
  // be linked from outreach, and are excluded from every discovery surface,
  // from search-engine indexing and from public reviews.
  //
  // Defaulted false and never written by the business editor or the public
  // API, so every existing row and every business a real owner creates is a
  // normal business with unchanged behaviour. Only the seed sets it true.
  isDemo Boolean @default(false)

  // ── Public URL identity ─────────────────────────────────────────────────
  // Immutable 10-char lowercase-alphanumeric key the public business URL is
  // resolved from: /{locale}/business/{name-derived-slug}-{shortId}. The
  // readable slug is derived from the current name at render time and is
  // presentation only — identity lives here, so renames need no slug history.
  //
  // Nullable: demo profiles keep NULL (their /business/<id> outreach URLs must
  // never change), and a real row without one serves its id URL as canonical —
  // no redirect can fire without a shortId. The migration's backfill UPDATE is
  // guarded with "shortId" IS NULL, so re-running it repairs such rows.
  // Written once at creation (lib/shortid.ts) and by the backfill migration;
  // never editable through the API (not in the pickFields whitelist).
  shortId String? @unique

  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  favorites    Favorite[]
  reviews      Review[]
  subscription Subscription?
  branches     Branch[]

  @@index([categoryId])
  @@index([latitude, longitude])
  @@index([status])
  @@map("businesses")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children   Category[] @relation("CategoryHierarchy")
  businesses Business[]

  @@unique([parentId, name])
  @@index([parentId])
  @@map("categories")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@map("favorites")
}

model Review {
  id         String   @id @default(cuid())
  businessId String
  authorName String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Subscription {
  id                   String             @id @default(cuid())
  businessId           String             @unique
  status               SubscriptionStatus @default(INACTIVE)
  plan                 SubscriptionPlan
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Branch {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  address      String?
  city         String?
  postalCode   String?
  country      String   @default("NO")
  phone        String?
  email        String?
  latitude     Float?
  longitude    Float?
  openingHours Json?
  isMainBranch Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("branches")
}

enum CompanySize {
  SELF_EMPLOYED
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum UserRole {
  BUSINESS
  ADMIN
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PAST_DUE
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}
